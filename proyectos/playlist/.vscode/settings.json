{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "explorer.compactFolders": false,
  "explorer.sortOrder": "foldersFirst",
  "files.exclude": {
    ".venv": true,
    "build": true,
    "dist": true,
    "data": true,
    ".ruff_cache": true,
    "**/__pycache__": true,
    "*.spec": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/build": true,
    "**/dist": true
  }
}
